{
  "manifest_version": 3,
  "name": "WardLock",
  "version": "1.0.0",
  "description": "Domain-verified TOTP fill from the WardLock desktop app. Local only - no cloud, no phone.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WardLock — fill code"
  }
}
